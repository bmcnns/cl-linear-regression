(in-package :cl-linear-regression)

(deftype matrix () "A matrix of doubles." '(simple-array double-float (* *)))
(deftype vec () "A vector of doubles." '(simple-array double-float (*)))
(deftype size () "A number of inputs or outputs." '(unsigned-byte 16))
(deftype row () "A row index." '(unsigned-byte 28))

(defun as-matrix (a)
  "A as a matrix of doubles (itself if it is one; a vector becomes one column)."
  (cond ((typep a 'matrix) a)
        ((= (array-rank a) 1)
         (let ((out (make-array (list (length a) 1) :element-type 'double-float)))
           (dotimes (i (length a) out) (setf (aref out i 0) (coerce (aref a i) 'double-float)))))
        (t (let ((out (make-array (array-dimensions a) :element-type 'double-float)))
             (dotimes (i (array-total-size a) out)
               (setf (row-major-aref out i) (coerce (row-major-aref a i) 'double-float)))))))

(defun as-rows (rows n)
  "ROWS (a sequence of row indices, or NIL for all N rows) as a vector of fixnums."
  (cond ((typep rows '(simple-array fixnum (*))) rows)
        ((null rows) (let ((v (make-array n :element-type 'fixnum))) (dotimes (r n v) (setf (aref v r) r))))
        (t (make-array (length rows) :element-type 'fixnum :initial-contents rows))))

(defun fit (x y &key (ridge 0d0) rows (intercept t) (penalize-intercept nil))
  "The weights W minimising |[X 1] W - Y|^2 + RIDGE |W|^2 over ROWS (all by default), one column per output."
  (let ((x (as-matrix x)) (y (as-matrix y)) (ridge (coerce ridge 'double-float)))
    (declare (type matrix x y) (type double-float ridge))
    (let* ((rows (as-rows rows (array-dimension x 0)))
           (n-obs (array-dimension x 1)) (d (if intercept (1+ n-obs) n-obs)) (n-act (array-dimension y 1))
           (xs (sb-ext:array-storage-vector x)) (ys (sb-ext:array-storage-vector y))
           (g (make-array (* d d) :element-type 'double-float :initial-element 0d0))
           (h (make-array (* d n-act) :element-type 'double-float :initial-element 0d0))
           (block (make-array (* 4 d) :element-type 'double-float))
           (targets (make-array (* 4 n-act) :element-type 'double-float))
           (xtx (make-array (list d d) :element-type 'double-float))
           (xty (make-array (list d n-act) :element-type 'double-float)))
      (declare (type vec xs ys g h block targets) (type size n-obs d n-act) (type (simple-array fixnum (*)) rows))
      (locally (declare (optimize speed (safety 0)))
        (loop for start of-type row from 0 below (length rows) by 4
              do (fill block 0d0) (fill targets 0d0)          ; a short last block: its missing rows add nothing
                 (loop for k of-type (integer 0 4) from 0 below (min 4 (- (length rows) start))
                       for r of-type row = (aref rows (+ start k))
                       do (replace block xs :start1 (* k d) :start2 (* r n-obs) :end2 (* (1+ r) n-obs))
                          (when intercept (setf (aref block (+ (* k d) n-obs)) 1d0))
                          (replace targets ys :start1 (* k n-act) :start2 (* r n-act) :end2 (* (1+ r) n-act)))
                 (dotimes (i d)
                   (declare (type size i))
                   (let ((a0 (aref block i)) (a1 (aref block (+ d i)))
                         (a2 (aref block (+ d d i))) (a3 (aref block (+ d d d i)))
                         (offset (* i d)))
                     (declare (type double-float a0 a1 a2 a3) (type (unsigned-byte 32) offset))
                     (loop for j of-type size from i below d
                           do (incf (aref g (+ offset j))
                                    (+ (* a0 (aref block j)) (* a1 (aref block (+ d j)))
                                       (* a2 (aref block (+ d d j))) (* a3 (aref block (+ d d d j))))))
                     (dotimes (c n-act)
                       (declare (type size c))
                       (incf (aref h (+ (* i n-act) c))
                             (+ (* a0 (aref targets c)) (* a1 (aref targets (+ n-act c)))
                                (* a2 (aref targets (+ n-act n-act c)))
                                (* a3 (aref targets (+ n-act n-act n-act c))))))))))
      (dotimes (i d)
        (dotimes (j d) (setf (aref xtx i j) (if (<= i j) (aref g (+ (* i d) j)) (aref g (+ (* j d) i)))))
        (when (or (< i n-obs) penalize-intercept)
          (incf (aref xtx i i) ridge))
        (dotimes (c n-act) (setf (aref xty i c) (aref h (+ (* i n-act) c)))))
      (solve xtx xty))))

(defun solve (a b)
  "X with A X = B, by Gaussian elimination with partial pivoting."
  (let ((a (as-matrix a)) (b (as-matrix b)))
    (declare (type matrix a b))
    (let* ((n (array-dimension a 0)) (m (array-dimension b 1))
           (lu (copy-seq (sb-ext:array-storage-vector a))) (x (copy-seq (sb-ext:array-storage-vector b))))
      (declare (type vec lu x) (type size n m))
      (locally (declare (optimize speed))
        (dotimes (k n)
          (let ((p k))
            (declare (type size p k))
            (loop for i of-type size from (1+ k) below n
                  when (> (abs (aref lu (+ (* i n) k))) (abs (aref lu (+ (* p n) k)))) do (setf p i))
            (when (zerop (aref lu (+ (* p n) k))) (error "The system is singular."))
            (when (/= p k)
              (dotimes (j n) (rotatef (aref lu (+ (* k n) j)) (aref lu (+ (* p n) j))))
              (dotimes (j m) (rotatef (aref x (+ (* k m) j)) (aref x (+ (* p m) j)))))
            (let ((pivot (aref lu (+ (* k n) k))))
              (loop for i of-type size from (1+ k) below n
                    do (let ((f (/ (aref lu (+ (* i n) k)) pivot)))
                         (declare (type double-float f))
                         (unless (zerop f)
                           (loop for j of-type size from (1+ k) below n
                                 do (decf (aref lu (+ (* i n) j)) (* f (aref lu (+ (* k n) j)))))
                           (dotimes (j m) (decf (aref x (+ (* i m) j)) (* f (aref x (+ (* k m) j)))))))))))
        (loop for k of-type (integer -1 65535) from (1- n) downto 0
              do (let ((pivot (aref lu (+ (* k n) k))))
                   (dotimes (j m)
                     (let ((s (aref x (+ (* k m) j))))
                       (declare (type double-float s))
                       (loop for i of-type size from (1+ k) below n
                             do (decf s (* (aref lu (+ (* k n) i)) (aref x (+ (* i m) j)))))
                       (setf (aref x (+ (* k m) j)) (/ s pivot)))))))
      (let ((out (make-array (list n m) :element-type 'double-float)))
        (replace (sb-ext:array-storage-vector out) x)
        out))))

(defun predict-into (xs r n-obs ws intercept a)
  "Row R's prediction under the weights WS, into A."
  (declare (type vec xs ws a) (type row r) (type size n-obs) (optimize speed))
  (let ((n-act (length a)))
    (dotimes (j n-act) (setf (aref a j) (if intercept (aref ws (+ (* n-obs n-act) j)) 0d0)))
    (dotimes (i n-obs a)
      (let ((xi (aref xs (+ (* r n-obs) i))) (row (* i n-act)))
        (dotimes (j n-act) (incf (aref a j) (* xi (aref ws (+ row j)))))))))

(defun predict (w x)
  "The predictions of the weights W (as FIT returns them) for each row of X."
  (let* ((w (as-matrix w)) (x (as-matrix x))
         (n (array-dimension x 0)) (n-obs (array-dimension x 1)) (n-act (array-dimension w 1))
         (intercept (= (array-dimension w 0) (1+ n-obs)))
         (a (make-array n-act :element-type 'double-float))
         (out (make-array (list n n-act) :element-type 'double-float)))
    (dotimes (r n out)
      (predict-into (sb-ext:array-storage-vector x) r n-obs (sb-ext:array-storage-vector w) intercept a)
      (dotimes (j n-act) (setf (aref out r j) (aref a j))))))

(defun squared-errors (x y w)
  "Each row's squared error, |prediction - Y|^2, under the weights W."
  (let ((x (as-matrix x)) (y (as-matrix y)) (w (as-matrix w)))
    (declare (type matrix x y w))
    (let* ((n (array-dimension x 0)) (n-obs (array-dimension x 1)) (n-act (array-dimension y 1))
           (intercept (= (array-dimension w 0) (1+ n-obs)))
           (xs (sb-ext:array-storage-vector x)) (ys (sb-ext:array-storage-vector y))
           (ws (sb-ext:array-storage-vector w))
           (a (make-array n-act :element-type 'double-float))
           (out (make-array n :element-type 'double-float)))
      (declare (type vec xs ys ws a out) (type row n) (type size n-obs n-act) (optimize speed))
      (dotimes (r n out)
        (declare (type row r))
        (predict-into xs r n-obs ws intercept a)
        (setf (aref out r) (let ((e 0d0))
                             (declare (type double-float e))
                             (dotimes (j n-act e) (incf e (expt (- (aref a j) (aref ys (+ (* r n-act) j))) 2)))))))))
